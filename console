<?php

/**
 * Console entry point for Dokpress commands.
 *
 * Defines `WD_BASE_PATH`, loads `app/bootstrap.php`, and registers every
 * class in `app/Command` whose file name matches the class name.
 */

use Symfony\Component\Console\Application;

if (!defined('WD_BASE_PATH')) {
    define('WD_BASE_PATH', __DIR__);
}

require __DIR__ . '/app/bootstrap.php';

$application = new Application();

$commandNamespace = 'App\\Command\\';
$commandDir = __DIR__ . '/app/Command';

$commands = [];
foreach (scandir($commandDir) as $file) {
    if (str_ends_with($file, '.php')) {
        $class = $commandNamespace . basename($file, '.php');
        $commands[] = new $class();
    }
}

$application->addCommands($commands);

$application->run();
