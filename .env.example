#-------------------------------------------------------------------------------
# Application Settings
#-------------------------------------------------------------------------------
APP_NAME="dokpress"
APP_DOMAIN="${APP_NAME}.local"
APP_URL="http://${APP_DOMAIN}"
APP_ENV="development"

# Local only. Enables Adminer (8080) and Mailpit (8025). Leave unset on Dokploy.
COMPOSE_PROFILES="dev"

# ------------------------------------------------------------------------------
# NGINX Settings
# ------------------------------------------------------------------------------
HTTP_PORT="80:80"
HTTPS_PORT="443:443"

# ------------------------------------------------------------------------------
# MariaDB Settings
# ------------------------------------------------------------------------------
MARIADB_DATABASE="${APP_NAME}"
MARIADB_USER="dev"
MARIADB_PASSWORD="S3nh4DB-Pass"
MARIADB_ROOT_PASSWORD="root"

#-------------------------------------------------------------------------------
# WP Config definitions
#-------------------------------------------------------------------------------
WP_DEBUG="true"
WP_ADMIN_USER="dev"
WP_ADMIN_PASSWORD="S3nh4WP-Dev"
WP_ADMIN_EMAIL="dev@${APP_DOMAIN}"
WP_BLOCK_UPDATE="true"
WP_HTTP_BLOCK_EXTERNAL="true"
WP_ACCESSIBLE_HOSTS="api.wordpress.org,*.wordpress.org,*.wp.com,downloads.wordpress.org"
WP_LOGIN_URL=
WP_UPLOADS_DIR="/var/projects/host-style/${APP_NAME}/uploads" #For development use: "./public/wp-content/uploads"

# Optional theme built by the CLI bootstrap and dokpress:theme-setup.
# THEME_DIR="public/wp-content/themes/my-theme"

#-------------------------------------------------------------------------------
# Redis object cache
#-------------------------------------------------------------------------------
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_PREFIX="${APP_NAME}"

#-------------------------------------------------------------------------------
# SMTP (msmtp)
# Development with Mailpit: SMTP_ENABLED=true, SMTP_HOST=mailpit, SMTP_PORT=1025,
# SMTP_AUTH=off, SMTP_TLS=off, SMTP_TLS_STARTTLS=off, and COMPOSE_PROFILES=dev.
# Production: real relay on port 587 with SMTP_AUTH=on and SMTP_TLS=on.
#-------------------------------------------------------------------------------
SMTP_ENABLED="false"
SMTP_HOST=
SMTP_PORT="587"
SMTP_FROM="dev@${APP_DOMAIN}"
SMTP_AUTH="off"
SMTP_TLS="off"
SMTP_TLS_STARTTLS="off"
SMTP_USER=
SMTP_PASSWORD=

#-------------------------------------------------------------------------------
# WordPress salts (php console dokpress:update-salts)
#-------------------------------------------------------------------------------
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=

#-------------------------------------------------------------------------------
# Database
#-------------------------------------------------------------------------------
DB_NAME="${APP_NAME}"
DB_USER="${MARIADB_USER}"
DB_PASSWORD="${MARIADB_PASSWORD}"
DB_HOST="mariadb"
DB_CHARSET="utf8mb4"
DB_COLLATE="utf8mb4_unicode_ci"
DB_TABLE_PREFIX="wp_"
DB_BACKUP_DIR="/var/projects/host-style/${APP_NAME}/backups" #For development use: "./public/wp-content/backups"

#-------------------------------------------------------------------------------
# Security headers
#-------------------------------------------------------------------------------
ENABLE_CONTENT_SECURITY_POLICY="false"
ENABLE_STRICT_TRANSPORT_SECURITY="true"
ENABLE_X_CONTENT_TYPE_OPTION="true"
ENABLE_X_FRAME_OPTION="true"
ENABLE_X_XSS_PROTECTION="true"
ENABLE_REFERRER_POLICY="true"
ENABLE_PERMISSIONS_POLICY="true"
ENABLE_CROSS_ORIGIN_EMBEDDER_POLICY="false"
ENABLE_CROSS_ORIGIN_OPENER_POLICY="true"

CONTENT_SECURITY_POLICY=
STRICT_TRANSPORT_SECURITY=
X_CONTENT_TYPE_OPTION=
X_FRAME_OPTION=
X_XSS_PROTECTION=
REFERRER_POLICY=
PERMISSIONS_POLICY=
CROSS_ORIGIN_EMBEDDER_POLICY=
CROSS_ORIGIN_OPENER_POLICY=
