{
    "name": "juniorenato/dokpress",
    "description": "Template for developing websites with WordPress and deploy with Dokploy",
    "type": "template",
    "license": "proprietary",
    "authors": [
        {
            "name": "Renato Rodrigues Jr",
            "email": "renato@hoststyle.com.br"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://packagist.org"
        },
        {
            "type": "composer",
            "url": "https://wpackagist.org"
        }
    ],
    "require": {
        "php": "^8.4",
        "composer/installers": "^2.3",
        "roots/wordpress": "*",
        "symfony/asset": "^7.4",
        "symfony/cache": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/filesystem": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/process": "^7.4",
        "symfony/rate-limiter": "^7.4",
        "wpackagist-plugin/redis-cache": "*",
        "wpackagist-plugin/wordfence": "*",
        "wpackagist-plugin/wordpress-seo": "*"
    },
    "extra": {
        "wordpress-install-dir": "public/wp-core/",
        "installer-paths": {
            "public/wp-content/plugins/{$name}/": [
                "type:wordpress-plugin"
            ],
            "public/wp-content/themes/{$name}/": [
                "type:wordpress-theme"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        },
        "allow-plugins": {
            "composer/installers": true,
            "roots/wordpress-core-installer": true
        }
    },
    "scripts": {
        "post-install-cmd": [
            "php console dokpress:setup"
        ],
        "post-update-cmd": [
            "@post-install-cmd"
        ]
    }
}
